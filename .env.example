# Active payment gateway: stripe or cybersource
PAYMENT_GATEWAY=stripe
SITE_URL=https://example.com

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CyberSource
CYBS_ENV=test
CYBS_MERCHANT_ID=
CYBS_API_KEY=
CYBS_SECRET_KEY=

# Receipt tokens: use a random value of at least 32 characters
PAYMENT_RECEIPT_SECRET=

# Server-managed discount rules, for example:
# {"WELCOME10":{"type":"percent","value":10,"active":true,"expiresAt":"2026-12-31T23:59:59Z","flows":["incorporation"]}}
DISCOUNT_CODES_JSON={}

# Email notifications
RESEND_API_KEY=
NOTIFY_EMAIL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
